# =========================
# Auth / Cookies
# =========================
AUTH_REFRESH_COOKIE_NAME=refresh_token_dev
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# =========================
# Security / Hashing
# =========================
SALT_ROUNDS=10

# =========================
# Seeding (Admin bootstrap)
# =========================
SEED_ADMIN=false
ADMIN_EMAIL=admin@higinex.com
ADMIN_PASSWORD=Admin123*

# =========================
# Swagger / Docs
# =========================
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# =========================
# Orders / Reservations
# =========================
RESERVATION_TTL_MINUTES=45
RESERVATION_CLEANUP_INTERVAL_MINUTES=10
ORDER_TAX_PERCENT=19

# =========================
# CORS Origins
# =========================
CORS_ORIGINS=http://localhost:4200

# =========================
# Email (SMTP - Resend example)
# =========================
EMAIL_PROVIDER=SMTP
# Note: 'onboarding@resend.dev' works only for testing with the email you signed up with on Resend.
# For production, verify your domain and use a real email like 'ventas@tudominio.com'.
EMAIL_FROM=onboarding@resend.dev
COMPANY_ORDERS_EMAIL=onboarding@resend.dev

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS="tu_resend_api_key_aqui"

# =========================
# Frontend Integration
# =========================
FRONTEND_URL=http://localhost:4200
EMAIL_VERIFY_URL=http://localhost:4200/auth/verify?token={token}